# ⚠️ 本文件是早期云端 SaaS 版遗留（PostgreSQL + JWT 登录鉴权 + CORS 白名单），
# 桌面版早已改成「本地 SQLite + 免登录单用户 + 模型 key 全内置走网关」，用户不需要、
# 也不应该手填这份 .env——桌面版根本没有登录/JWT/多租户这些概念了。
#
# 桌面版真正要看的配置模板 → `desktop/bundled.env.example`
#   （打包前复制成 `desktop/bundled.env` 并填「网关地址 + app 令牌」——不是真 key，
#     真平台 key 只在服务器 `gw.env`，详见 `gateway/README.md`）。
#
# 架构/规范以 `CLAUDE.md` 为准。本文件仅作历史存档保留，请勿参照下面的变量配置桌面版。
# ────────────────────────────────────────────────────────────────

# ── 数据库（历史 SaaS 版用 PG，桌面版用本地 SQLite，无需配置）──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=billiards_ai

# ── JWT（历史 SaaS 版登录鉴权用，桌面版已删整套登录/JWT/多租户）──
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS（历史 SaaS 版用）──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── 文件上传（桌面版落点用 UPLOAD_DIR 指向 userData 可写目录，由 desktop/src/backend.js 注入，不走此处）──
# UPLOAD_DIR=/var/www/billiards-ai/uploads

# ── AI 文本模型（历史 SaaS 版直连 DeepSeek；桌面版模型 key 全内置走网关，见 desktop/bundled.env.example）──
TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-real-deepseek-key

# ── AI 图片模型（历史 SaaS 版直连 OpenAI；桌面版同样走网关，不直连）──
OPENAI_API_KEY=replace-with-real-openai-key
IMAGE_MODEL_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1

# ── OSS（历史 SaaS 版可选云存储，桌面版不用）──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
