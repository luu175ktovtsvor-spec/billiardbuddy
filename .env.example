# ── 数据库 ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=billiards_ai

# ── JWT ──
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── 文件上传 ──
UPLOAD_DIR=uploads

# ── AI 文本模型（DeepSeek V4 Flash）──
TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-real-deepseek-key

# ── AI 图片模型（OpenAI GPT Image 2）──
OPENAI_API_KEY=replace-with-real-openai-key
IMAGE_MODEL_PROVIDER=openai

# ── OSS（可选）──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
