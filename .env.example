# ── 数据库 ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=billiards_ai

# ── JWT ──
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS ──
# 多个域名用逗号分隔
# 生产示例：CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── 文件上传 ──
# 生产建议改为绝对路径，如 /var/www/billiards/uploads
UPLOAD_DIR=uploads

# ── AI Provider ──
TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-real-deepseek-key

# 百炼模型网关（Fallback 及多模型路由）
BAILIAN_API_KEY=replace-with-real-bailian-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_DEFAULT_MODEL=qwen-plus

# P2 阶段启用（当前留空即可）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
IMAGE_MODEL_PROVIDER=openai

# P2 阶段启用（当前留空即可）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
