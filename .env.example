# ── 数据库 ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=billiards_ai

# ── JWT ──
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── 文件上传（务必用绝对路径！相对路径的落点取决于进程工作目录，
#    systemd 与本地开发会写到不同位置。不设则默认 <项目根>/uploads）──
# UPLOAD_DIR=/var/www/billiards-ai/uploads

# ── AI 文本模型（DeepSeek V4 Flash）──
TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-real-deepseek-key

# ── AI 图片模型（OpenAI GPT Image 2）──
OPENAI_API_KEY=replace-with-real-openai-key
IMAGE_MODEL_PROVIDER=openai
# 经 Cloudflare Worker 代理访问 OpenAI（生产现行配置）。
# 说明：美国服务器直连 api.openai.com 网络上可行，但保留代理有两个理由：
#   ① 国内本地开发直连不通，走代理则两个环境共用一份配置
#   ② 出口 IP 是 Cloudflare 而非阿里云机房段，规避 OpenAI 对云厂商 IP 的风控不确定性
# 不配置此项则直连 api.openai.com
OPENAI_BASE_URL=https://openai-proxy.luu175ktovtsvor.workers.dev/v1

# ── OSS（可选）──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
