# dataeye/deploy/dataeye-board.service
# 装到服务器: /etc/systemd/system/dataeye-board.service
# 装法见 dataeye/deploy/runbook.md
[Unit]
Description=Dataeye Readonly Board
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/dataeye
Environment=PGDSN=postgresql://dataeye:<db密码>@127.0.0.1/dataeye
ExecStart=/usr/bin/env bun run board/app.ts --host 127.0.0.1 --port 9200
Restart=always
RestartSec=3
User=<运行用户,如 dataeye 或 root>

[Install]
WantedBy=multi-user.target
