# ============================================================
# 球房 AI 运营助手 — 生产环境配置模板
# 复制此文件为 .env 并填写实际值
# 生成密钥: openssl rand -hex 32
# ============================================================

# --- 环境（必须为 production，否则生产防护开关不生效） ---
APP_ENV=production

# --- 数据库 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=billiards
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=billiards_ai

# --- JWT ---
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS

# --- CORS ---
# 改为你的实际域名
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- 文件存储（务必绝对路径；不设则默认 <项目根>/uploads） ---
UPLOAD_DIR=/var/www/billiards-ai/uploads

# --- AI Provider (文本) ---
TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- AI Provider (图片：OpenAI gpt-image-2，经 Cloudflare Worker 代理) ---
IMAGE_MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-CHANGE_ME
# 生产经 Worker 代理；不配则直连 api.openai.com
OPENAI_BASE_URL=https://openai-proxy.luu175ktovtsvor.workers.dev/v1

# --- 阿里云 OSS（P2 阶段，可选） ---
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
