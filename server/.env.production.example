# ============================================================
# 球房 AI 运营助手 — 生产环境配置模板
# 复制此文件为 .env 并填写实际值
# 生成密钥: openssl rand -hex 32
# ============================================================

# --- 环境 ---
APP_ENV=production

# --- 数据库 ---
# Docker 内部用 postgres 作主机名（对应 docker-compose.yml 中的 postgres 服务）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=billiards
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=billiards_ai

# --- JWT ---
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS

# --- CORS ---
# 改为你的实际域名
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- 文件存储 ---
UPLOAD_DIR=/app/uploads

# --- AI Provider (文本) ---
TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- AI Provider (图片) ---
IMAGE_MODEL_PROVIDER=aliyun
IMAGE_MODEL_NAME=
DASHSCOPE_API_KEY=sk-CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME

# --- 百炼模型网关（可选） ---
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_DEFAULT_MODEL=qwen-plus

# --- 阿里云 OSS（P2 阶段，可选） ---
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=