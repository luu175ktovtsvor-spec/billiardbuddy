+fn remove_inherited_secret_environment(command: &mut Command) {
+    // Hooks execute external commands. Do not let them inherit the App
+    // Server's credential capabilities; explicitly configured hook values are
+    // applied afterwards in run_command.
+    for (name, _) in std::env::vars_os() {
+        if is_default_excluded_environment_variable_name(&name) {
+            command.env_remove(name);
+        }
+    }
