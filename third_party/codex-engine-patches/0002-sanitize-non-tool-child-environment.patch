+/// Returns whether an environment variable name matches the default secret
+/// exclusions shared by shell tools and non-tool subprocesses.
+pub fn is_default_excluded_environment_variable_name(name: &OsStr) -> bool {
+    let uppercase_name = name.to_string_lossy().to_ascii_uppercase();
+    uppercase_name.contains("KEY")
+        || uppercase_name.contains("SECRET")
+        || uppercase_name.contains("TOKEN")
+}
