diff --git a/codex-rs/core-plugins/src/subprocess_environment.rs b/codex-rs/core-plugins/src/subprocess_environment.rs
new file mode 100644
index 0000000..af771e1
--- /dev/null
+++ b/codex-rs/core-plugins/src/subprocess_environment.rs
@@ -0,0 +1,14 @@
+use std::process::Command;
+
+use codex_protocol::shell_environment::is_default_excluded_environment_variable_name;
+
+/// Removes inherited credential-like variables before a plugin-management
+/// subprocess is launched. Callers may add their explicit command environment
+/// afterwards.
+pub(crate) fn remove_inherited_secret_environment(command: &mut Command) {
+    for (name, _) in std::env::vars_os() {
+        if is_default_excluded_environment_variable_name(&name) {
+            command.env_remove(name);
+        }
+    }
+}
