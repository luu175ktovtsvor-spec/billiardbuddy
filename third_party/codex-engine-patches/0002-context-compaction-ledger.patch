From ee0247f95a6fe2b094ba2253d82cae2a2b4c2dff Mon Sep 17 00:00:00 2001
Subject: [BilliardBuddy] expose durable context-compaction metadata

BilliardBuddy owns recoverable product state, while the embedded App Server
owns one private Codex Thread/Turn execution loop. The upstream
`contextCompaction` item carried an identifier only, so an embedding host
could not atomically record the compaction summary and token boundary before
the source resumed model sampling.

This opt-in-neutral patch keeps standard behavior unchanged and adds the
source trigger, input/output token estimates and resulting summary to the
item's App Server representation. The product consumes these fields only in
its private `billiardbuddy` embedding mode.

---
 codex-rs/app-server-protocol/schema/typescript/v2/ThreadItem.ts | 2 +-
 codex-rs/app-server-protocol/src/protocol/v2/item.rs            | 16 ++++++++++++++--
 codex-rs/core/src/compact.rs                                    | 19 +++++++++++++++++--
 codex-rs/protocol/src/items.rs                                  | 22 +++++++++++++++++++++-
 4 files changed, 53 insertions(+), 6 deletions(-)

diff --git a/codex-rs/app-server-protocol/schema/typescript/v2/ThreadItem.ts b/codex-rs/app-server-protocol/schema/typescript/v2/ThreadItem.ts
index f793210..de3eda5 100644
--- a/codex-rs/app-server-protocol/schema/typescript/v2/ThreadItem.ts
+++ b/codex-rs/app-server-protocol/schema/typescript/v2/ThreadItem.ts
@@ -114,4 +114,4 @@ reasoningEffort: ReasoningEffort | null,
 /**
  * Last known status of the target agents, when available.
  */
-agentsStates: { [key in string]?: CollabAgentState }, } | { "type": "subAgentActivity", id: string, kind: SubAgentActivityKind, agentThreadId: string, agentPath: string, } | { "type": "webSearch" } & WebSearchItem | { "type": "imageView", id: string, path: LegacyAppPathString, } | { "type": "sleep" } & SleepItem | { "type": "imageGeneration" } & ImageGenerationItem | { "type": "enteredReviewMode", id: string, review: string, } | { "type": "exitedReviewMode", id: string, review: string, } | { "type": "contextCompaction", id: string, };
+agentsStates: { [key in string]?: CollabAgentState }, } | { "type": "subAgentActivity", id: string, kind: SubAgentActivityKind, agentThreadId: string, agentPath: string, } | { "type": "webSearch" } & WebSearchItem | { "type": "imageView", id: string, path: LegacyAppPathString, } | { "type": "sleep" } & SleepItem | { "type": "imageGeneration" } & ImageGenerationItem | { "type": "enteredReviewMode", id: string, review: string, } | { "type": "exitedReviewMode", id: string, review: string, } | { "type": "contextCompaction", id: string, source: string | null, inputTokens: bigint | null, outputTokens: bigint | null, summary: string | null, };

diff --git a/codex-rs/app-server-protocol/src/protocol/v2/item.rs b/codex-rs/app-server-protocol/src/protocol/v2/item.rs
index a98ec3f..3a9d176 100644
--- a/codex-rs/app-server-protocol/src/protocol/v2/item.rs
+++ b/codex-rs/app-server-protocol/src/protocol/v2/item.rs
@@ -394,5 +394,9 @@ pub enum ThreadItem {
     #[ts(rename_all = "camelCase")]
     ContextCompaction {
         id: String,
+        source: Option<String>,
+        input_tokens: Option<i64>,
+        output_tokens: Option<i64>,
+        summary: Option<String>,
     },
 }
@@ -969,7 +973,13 @@ impl From<CoreTurnItem> for ThreadItem {
                 }
             }
             CoreTurnItem::ContextCompaction(compaction) => {
-                ThreadItem::ContextCompaction { id: compaction.id }
+                ThreadItem::ContextCompaction {
+                    id: compaction.id,
+                    source: compaction.source,
+                    input_tokens: compaction.input_tokens,
+                    output_tokens: compaction.output_tokens,
+                    summary: compaction.summary,
+                }
             }
         }
     }

diff --git a/codex-rs/core/src/compact.rs b/codex-rs/core/src/compact.rs
index ba0b189..bf6b53a 100644
--- a/codex-rs/core/src/compact.rs
+++ b/codex-rs/core/src/compact.rs
@@ -208,6 +208,7 @@ async fn run_compact_task_inner(
         Arc::clone(&turn_context),
         input,
         initial_context_injection,
+        trigger,
         compaction_metadata,
     )
     .await;
@@ -243,9 +244,17 @@ async fn run_compact_task_inner_impl(
     turn_context: Arc<TurnContext>,
     input: Vec<UserInput>,
     initial_context_injection: InitialContextInjection,
+    trigger: CompactionTrigger,
     compaction_metadata: CompactionTurnMetadata,
 ) -> CodexResult<String> {
-    let compaction_item = TurnItem::ContextCompaction(ContextCompactionItem::new());
+    let source = match trigger {
+        CompactionTrigger::Auto => "automatic",
+        CompactionTrigger::Manual => "manual",
+    };
+    let mut compaction_item = TurnItem::ContextCompaction(ContextCompactionItem::with_metadata(
+        source.to_string(),
+        sess.get_total_token_usage().await.max(1),
+    ));
     sess.emit_turn_item_started(&turn_context, &compaction_item)
         .await;
     let initial_input_for_turn: ResponseInputItem = ResponseInputItem::from(input);
@@ -349,4 +358,8 @@ async fn run_compact_task_inner_impl(
     let history_items = history_snapshot.raw_items();
     let summary_suffix = get_last_assistant_message_from_turn(history_items).unwrap_or_default();
     let summary_text = format!("{SUMMARY_PREFIX}\n{summary_suffix}");
+    if let TurnItem::ContextCompaction(item) = &mut compaction_item {
+        item.output_tokens = Some(i64::try_from(summary_text.chars().count() / 4 + 1).unwrap_or(i64::MAX));
+        item.summary = Some(summary_text.clone());
+    }
     let user_messages = collect_user_messages(history_items);

diff --git a/codex-rs/protocol/src/items.rs b/codex-rs/protocol/src/items.rs
index 7c25d79..36bb92b 100644
--- a/codex-rs/protocol/src/items.rs
+++ b/codex-rs/protocol/src/items.rs
@@ -434,4 +434,8 @@ pub struct McpToolCallError {
 #[derive(Debug, Clone, Deserialize, Serialize, TS, JsonSchema)]
 pub struct ContextCompactionItem {
     pub id: String,
+    pub source: Option<String>,
+    pub input_tokens: Option<i64>,
+    pub output_tokens: Option<i64>,
+    pub summary: Option<String>,
 }
@@ -443,5 +447,21 @@ impl ContextCompactionItem {
 impl ContextCompactionItem {
     pub fn new() -> Self {
-        Self { id: new_item_id() }
+        Self {
+            id: new_item_id(),
+            source: None,
+            input_tokens: None,
+            output_tokens: None,
+            summary: None,
+        }
+    }
+
+    pub fn with_metadata(source: String, input_tokens: i64) -> Self {
+        Self {
+            id: new_item_id(),
+            source: Some(source),
+            input_tokens: Some(input_tokens),
+            output_tokens: None,
+            summary: None,
+        }
     }
 }
