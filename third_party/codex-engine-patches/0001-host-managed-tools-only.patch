@@ -229,4 +229,8 @@ pub struct ConfigToml {
     /// Whether to inject the `<environment_context>` user block.
     pub include_environment_context: Option<bool>,
-
+
+    /// Expose only host-provided dynamic tools. Built-in, MCP, extension and
+    /// environment tools remain unavailable to the model.
+    pub host_managed_tools_only: Option<bool>,
+
     /// Optional path to a file containing model instructions that will override
diff --git a/codex-rs/core/src/config/mod.rs b/codex-rs/core/src/config/mod.rs
index f6667ae..e799950 100644
--- a/codex-rs/core/src/config/mod.rs
+++ b/codex-rs/core/src/config/mod.rs
@@ -706,4 +706,8 @@ pub struct Config {
     /// Whether to inject the `<environment_context>` user block.
     pub include_environment_context: bool,
-
+
+    /// When true, the embedding host is the sole tool authority. The engine
+    /// exposes only explicit dynamic tools supplied by that host.
+    pub host_managed_tools_only: bool,
+
     /// Compact prompt override.
@@ -3843,6 +3847,7 @@ impl Config {
             .and_then(|skills| skills.include_instructions)
             .unwrap_or(true);
         let include_environment_context = cfg.include_environment_context.unwrap_or(true);
+        let host_managed_tools_only = cfg.host_managed_tools_only.unwrap_or(false);
         let guardian_policy_config =
             guardian_policy_config_from_requirements(config_layer_stack.requirements_toml())
                 .or_else(|| {
@@ -4048,6 +4053,7 @@ impl Config {
             orchestrator_skills_enabled,
             orchestrator_mcp_enabled,
             include_environment_context,
+            host_managed_tools_only,
             // The config.toml omits "_mode" because it's a config file. However, "_mode"
             // is important in code to differentiate the mode from the store implementation.
             cli_auth_credentials_store_mode: resolve_cli_auth_credentials_store_mode(
diff --git a/codex-rs/core/src/session/config_lock.rs b/codex-rs/core/src/session/config_lock.rs
index bbc2e20..e9831d4 100644
--- a/codex-rs/core/src/session/config_lock.rs
+++ b/codex-rs/core/src/session/config_lock.rs
@@ -144,4 +144,5 @@ fn save_config_resolved_fields(
     lock_config.include_collaboration_mode_instructions =
         Some(config.include_collaboration_mode_instructions);
     lock_config.include_environment_context = Some(config.include_environment_context);
+    lock_config.host_managed_tools_only = Some(config.host_managed_tools_only);
     lock_config.background_terminal_max_timeout = Some(config.background_terminal_max_timeout);
diff --git a/codex-rs/core/src/tools/spec_plan.rs b/codex-rs/core/src/tools/spec_plan.rs
index 157644d..08cb18b 100644
--- a/codex-rs/core/src/tools/spec_plan.rs
+++ b/codex-rs/core/src/tools/spec_plan.rs
@@ -136,4 +136,13 @@ pub(crate) fn build_tool_router(
         wait_agent_timeouts: wait_agent_timeout_options(turn_context),
