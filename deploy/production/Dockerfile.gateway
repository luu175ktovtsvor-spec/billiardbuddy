FROM oven/bun:1.3.14

WORKDIR /app/gateway

# Keep the Gateway image to its explicit runtime closure. In particular, it
# contains no desktop credentials, Thread Store or old TypeScript Agent code.
COPY --chown=bun:bun gateway/app.ts gateway/installationAuth.ts gateway/transcription.ts gateway/modelCapacity.ts gateway/managedResponses.ts gateway/mimoChat.ts gateway/visionBridge.ts gateway/providerRegistry.ts gateway/usageBudget.ts gateway/operationResultStore.ts gateway/validate-deployment-env.ts ./
COPY --chown=bun:bun ts/shared/product/providerContracts.ts /app/ts/shared/product/providerContracts.ts
COPY --chown=bun:bun ts/shared/product/providerGateway.ts /app/ts/shared/product/providerGateway.ts

USER bun
EXPOSE 8799
CMD ["bun", "/app/gateway/app.ts", "--host", "0.0.0.0", "--port", "8799"]
