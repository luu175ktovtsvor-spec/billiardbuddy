# 桌面 app 内置配置【模板】。打包前复制成 desktop/bundled.env 并填真值(bundled.env 不进 git)。
# 原则:全部指向【国内网关】,真 key 一律不在客户端(在服务器 /opt/qfgw/gw.env);客户端只带可吊销+限额的 app 令牌。
# 用 IP 而非域名:本机若有代理(Clash)会劫持域名 DNS、但不拦裸 IP → 开着代理也能用。
DESKTOP_LOCAL=1

# 文字(MiMo)经网关 → 网关直连小米
DEEPSEEK_BASE_URL=http://<网关IP>/gw/v1
DEEPSEEK_API_KEY=<app令牌(GW_APP_TOKENS 里的)>
TEXT_MODEL_NAME=mimo-v2.5

# 生图(GPT Image)经网关 → 网关转美国 relay → OpenAI
OPENAI_BASE_URL=http://<网关IP>/gw/v1
OPENAI_API_KEY=<app令牌>
IMAGE_MODEL_NAME=gpt-image-2

# 内置模型展示名
BUNDLED_MODEL_LABEL=MiMo V2.5
BUNDLED_IMAGE_LABEL=GPT Image-2
BUNDLED_VIDEO_LABEL=Seedance 2.0

# 视频(Seedance)经网关 —— 待客户端 video_service 接网关后启用(见 gateway/README 待办)
# GW_VIDEO_URL=http://<网关IP>/gw/v1/video/generations
# GW_TOKEN=<app令牌>
