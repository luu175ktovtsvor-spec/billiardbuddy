{
  "name": "billiards-desktop-agent",
  "version": "1.0.2",
  "private": true,
  "description": "帮台球房写文案、做海报、剪视频、整理文件的 AI 助手",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "DESKTOP_APP_URL=http://localhost:3000 electron .",
    "build:backend": "node scripts/build_backend.js",
    "build:frontend": "node scripts/build_frontend.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "cn.zzyppz.billiards.desktop",
    "productName": "台球运营助手",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "publisher",
        "to": "publisher",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.venv/**",
          "!**/cookies/**"
        ]
      },
      {
        "from": "resources/publisher-bin",
        "to": "publisher-bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/frontend",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bundled.env",
        "to": "bundled.env"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "publisher/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://zzyppz.cn/desktop/",
        "channel": "latest"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "台球运营助手"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
