{
  "$id": "billiardbuddy/legacy-support-matrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "properties": {
          "backup_strategy": {
            "type": "string"
          },
          "fixture": {
            "type": "string"
          },
          "fixture_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "idempotence_test": {
            "type": "string"
          },
          "idempotence_test_id": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "disk",
              "wire",
              "localStorage"
            ]
          },
          "migration_owner_module": {
            "type": "string"
          },
          "positive_test": {
            "type": "string"
          },
          "positive_test_id": {
            "type": "string"
          },
          "reader_entry": {
            "type": "string"
          },
          "release_association": {
            "type": "string"
          },
          "status": {
            "enum": [
              "supported",
              "current",
              "provisional",
              "current_only",
              "unsupported"
            ]
          },
          "storage_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "storage_id",
          "layer"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "matrix_revision": {
      "minLength": 1,
      "type": "string"
    },
    "matrix_schema_version": {
      "const": 1
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "matrix_schema_version",
    "matrix_revision",
    "source_sha256",
    "entries"
  ],
  "type": "object",
  "x-contract-source-sha256": "8445b9a6e144e73d8fa81757b2c1f4e38de434e1bdbb099b6e5eb3ad3f63370d"
}
