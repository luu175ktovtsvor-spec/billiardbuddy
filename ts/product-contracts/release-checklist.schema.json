{
  "$id": "billiardbuddy/release-checklist.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "component_matrix_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_input": {
            "type": "string"
          },
          "check_id": {
            "type": "string"
          },
          "evidence_path": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "owner": {
            "enum": [
              "machine",
              "user"
            ]
          },
          "pass_condition": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "procedure": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "UNVERIFIED"
            ]
          }
        },
        "required": [
          "check_id",
          "module",
          "required",
          "platform",
          "candidate_input",
          "procedure",
          "pass_condition",
          "evidence_path",
          "owner",
          "result"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "policy_digests": {
      "additionalProperties": false,
      "properties": {
        "attachment-retention-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "auth-entitlement-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "automatic-reviewer-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "content-safety-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "data-egress-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "diagnostic-bundle-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "media-storage-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "migration-backup-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "permission-profile-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "production-load-profile": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "relay-retention-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "system-support-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "usage-budget-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "voice-retention-policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "attachment-retention-policy",
        "voice-retention-policy",
        "media-storage-policy",
        "migration-backup-policy",
        "content-safety-policy",
        "relay-retention-policy",
        "diagnostic-bundle-policy",
        "system-support-policy",
        "data-egress-policy",
        "auth-entitlement-policy",
        "usage-budget-policy",
        "production-load-profile",
        "permission-profile-policy",
        "automatic-reviewer-policy"
      ],
      "type": "object"
    },
    "schema_version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "component_matrix_digest",
    "policy_digests",
    "items"
  ],
  "title": "BilliardBuddy release checklist",
  "type": "object",
  "x-contract-source-sha256": "a37dfaffec5d240000004a2360bc19b7cbd636f17c450fc458fdb7fd043daf3e"
}
