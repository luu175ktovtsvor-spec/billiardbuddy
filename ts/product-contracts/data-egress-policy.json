{
  "policy_schema_version": 1,
  "policy_revision": "bb-04e-image-v1",
  "owner_module": "04",
  "scope": [
    "TextReasoning",
    "VisualEvidence",
    "ImageGeneration",
    "SpeechTranscription"
  ],
  "disclosure": {
    "purpose": "image_generation",
    "data": [
      "prompt",
      "reference_images_when_editing"
    ],
    "path": [
      "BilliardBuddy desktop",
      "United States Relay",
      "selected image provider"
    ],
    "billable": true,
    "revocable_until": "provider_submission"
  },
  "consent_receipt": {
    "per_operation": true,
    "persisted_before_network": true,
    "bound_to_input_fingerprint": true,
    "gateway_fail_closed": true,
    "relay_fail_closed": true
  },
  "managed_remote_consent": {
    "policy_revision": "bb-04f-managed-remote-v1",
    "capabilities": [
      "TextReasoning",
      "VisualEvidence",
      "SpeechTranscription"
    ],
    "first_use_disclosure": true,
    "installation_bound": true,
    "persisted_before_network": true,
    "revocable": true,
    "gateway_fail_closed": true,
    "protocol": "bb-provider-gateway/1.0"
  },
  "provider_retention": {
    "DeepSeek": {
      "status": "PUBLIC_POLICY_VERIFIED_ACCOUNT_API_TERM_NOT_VERIFIED",
      "summary": "personal information is retained for the minimum necessary period; legally required network logs may be retained for at least six months",
      "source": "https://platform.deepseek.com/downloads/DeepSeek%20Privacy%20Policy.pdf",
      "verified_at": "2026-07-24"
    },
    "Xiaomi MiMo": {
      "status": "PUBLIC_GENERAL_POLICY_VERIFIED_ACCOUNT_API_TERM_NOT_VERIFIED",
      "summary": "information is retained while needed for its collection purpose or applicable legal requirements; the MiMo API account-specific term is not verified",
      "source": "https://privacy.mi.com/all/en_US/",
      "verified_at": "2026-07-24"
    },
    "Alibaba Cloud Model Studio Fun-ASR": {
      "status": "PUBLIC_STORAGE_STATEMENT_VERIFIED_ACCOUNT_TERM_NOT_VERIFIED",
      "summary": "Model Studio states that model-call data is stored under applicable law and its service agreement; the account-specific duration is not verified",
      "source": "https://help.aliyun.com/en/model-studio/privacy-notice",
      "verified_at": "2026-07-24"
    },
    "OpenAI": {
      "status": "PUBLIC_DEFAULT_VERIFIED_ACCOUNT_OVERRIDE_NOT_VERIFIED",
      "summary": "API image endpoints have no application-state retention; default abuse-monitoring logs may retain customer content for up to 30 days",
      "source": "https://platform.openai.com/docs/models/default-usage-policies-by-endpoint",
      "verified_at": "2026-07-24"
    },
    "ByteDance Ark": {
      "status": "PUBLIC_CONTRACT_VERIFIED_ACCOUNT_TERM_NOT_VERIFIED",
      "summary": "customer data is processed for the necessary contracted period; account-specific term is not verified",
      "source": "https://www.volcengine.com/docs/undefined/67493?lang=zh",
      "verified_at": "2026-07-24"
    }
  },
  "evidence": [
    {
      "constraint": "user_disclosure_before_egress",
      "path": "ts/desktop/src/components/media/ImageWorkbench.test.tsx",
      "test_id": "warns before creating another paid task and forwards explicit confirmation"
    },
    {
      "constraint": "host_receipt_before_forward",
      "path": "ts/src/server/services/mediaProjectService.test.ts",
      "test_id": "requires an explicit data egress acknowledgement before persisting or forwarding a paid image task"
    },
    {
      "constraint": "gateway_fail_closed",
      "path": "gateway/app.test.ts",
      "test_id": "image task submission requires trusted consent and an operation id before relay work"
    },
    {
      "constraint": "managed_remote_user_disclosure",
      "path": "ts/desktop/src/product/components/RemoteDataEgressConsent.test.tsx",
      "test_id": "shows purpose, receivers, retention, billing and revocation before granting"
    },
    {
      "constraint": "managed_remote_receipt_is_revocable",
      "path": "ts/src/server/services/remoteDataEgressConsent.test.ts",
      "test_id": "managed remote consent is installation-bound, durable and revocable"
    },
    {
      "constraint": "old_component_fails_before_provider",
      "path": "gateway/app.test.ts",
      "test_id": "provider routes reject an authenticated old component before any paid work"
    }
  ],
  "external_verification": {
    "openai_account_retention_override": "NOT_VERIFIED_EXTERNALLY",
    "ark_account_retention_term": "NOT_VERIFIED_EXTERNALLY",
    "deepseek_account_api_retention_term": "NOT_VERIFIED_EXTERNALLY",
    "mimo_account_api_retention_term": "NOT_VERIFIED_EXTERNALLY",
    "fun_asr_account_retention_term": "NOT_VERIFIED_EXTERNALLY"
  },
  "sha256": "8ce4f703bb10a47196d5b6203f1a3f3f48807b77a107f9551b2446a0638164f7"
}
