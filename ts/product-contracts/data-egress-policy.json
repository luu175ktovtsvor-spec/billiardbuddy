{
  "policy_schema_version": 1,
  "policy_revision": "bb-remote-processing-v2",
  "owner_module": "04",
  "scope": [
    "TextReasoning",
    "VisualEvidence",
    "MediaReasoning",
    "ImageGeneration",
    "SpeechTranscription"
  ],
  "disclosure": {
    "presentation": "single_privacy_statement",
    "surface": "settings/privacy",
    "purpose": "complete the remote capability selected by the user",
    "data": [
      "task text required by the selected capability",
      "images, audio or bounded media evidence required by the selected capability"
    ]
  },
  "execution_contract": {
    "per_operation_consent": false,
    "billing_confirmation": false,
    "installation_identity_required": true,
    "ordinary_tool_permissions_preserved": true,
    "operation_identity_required_for_durable_side_effects": true,
    "idempotency_required_for_durable_side_effects": true,
    "timeouts_and_cancellation_required": true,
    "quota_enforced_before_upstream_submission": true,
    "protocol": "bb-provider-gateway/1.0"
  },
  "evidence": [
    {
      "constraint": "remote_processing_disclosed_once",
      "path": "ts/desktop/src/product/components/ProductPrivacySettings.test.tsx",
      "test_id": "states remote processing once without consent, billing or provider controls"
    },
    {
      "constraint": "host_forwards_protocol_without_consent_header",
      "path": "ts/src/server/agent-worker/productModelRuntime.test.ts",
      "test_id": "sends the product prompt and provider-neutral history directly as OpenAI Chat"
    },
    {
      "constraint": "gateway_requires_operation_identity_before_relay",
      "path": "gateway/app.test.ts",
      "test_id": "image task submission requires an operation id before relay work"
    },
    {
      "constraint": "media_job_keeps_idempotency_without_consent",
      "path": "ts/src/server/services/mediaProjectService.test.ts",
      "test_id": "uses one idempotent GPT edit task without legacy parameters and persists local image bytes"
    }
  ],
  "sha256": "be0b93a4176b9d0a3168b62678cf04df3ecda787cf7518af497deff22a7ecdf7"
}
