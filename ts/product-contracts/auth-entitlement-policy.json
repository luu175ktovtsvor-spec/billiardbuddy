{
  "policy_schema_version": 1,
  "policy_revision": "bb-04a-license-activation",
  "owner_module": "04",
  "evidence": [
    {
      "constraint": "cross_process_transaction",
      "path": "ts/shared/product/authEntitlement.test.ts",
      "test_id": "a healthy multi-process lock survives longer than staleLockMs and a killed owner is reclaimed"
    },
    {
      "constraint": "lock_owner_identity",
      "path": "ts/shared/product/authEntitlement.test.ts",
      "test_id": "an old holder finally cannot delete a replacement lock owner record"
    },
    {
      "constraint": "provisioning_revision",
      "path": "ts/shared/product/authEntitlement.test.ts",
      "test_id": "newer inactive provisioning revokes access and refresh across restart"
    },
    {
      "constraint": "session_revocation",
      "path": "ts/shared/product/authEntitlement.test.ts",
      "test_id": "refresh and installation revocation serialize without resurrecting a session"
    },
    {
      "constraint": "sidecar_rotation",
      "path": "ts/desktop/electron/services/serverRuntime.test.ts",
      "test_id": "waits for the old child exit before spawning exactly one replacement"
    },
    {
      "constraint": "host_env_scrub",
      "path": "ts/src/server/agent-worker/ipcLauncher.test.ts",
      "test_id": "actual agent-worker child receives no host gateway credentials while retaining IPC-safe environment"
    },
    {
      "constraint": "refresh_proof_logout",
      "path": "ts/desktop/electron/services/installationSession.test.ts",
      "test_id": "uses the rotated refresh proof when logout races an in-flight refresh without updating the sidecar"
    },
    {
      "constraint": "strict_device_limit",
      "path": "ts/shared/product/authEntitlement.test.ts",
      "test_id": "two durable instances atomically enforce device limit and issue a usable winner token"
    }
  ],
  "authorization": {
    "sole_activation_route": "license",
    "principal_chain": [
      "AccessPrincipal",
      "InstallationRegistration",
      "Entitlement",
      "installation_access_token"
    ],
    "owner": "verified_principal_and_installation",
    "bootstrap_credential": "activation_only",
    "untrusted_inputs": [
      "installation_id",
      "X-QF-Client-ID",
      "client_plan"
    ],
    "gateway_offline_grace": false
  },
  "constraints": {
    "durable_authority": true,
    "device_limit_atomic": true,
    "revoked_registration_cannot_reactivate": true,
    "refresh_rotation_single_use": true,
    "access_audience_expiry_session_entitlement_verified": true,
    "safe_storage_required": true,
    "auth_json_max_bytes": 4096,
    "cross_process_transaction": true,
    "lock_owner_identity": true,
    "provisioning_revision": true,
    "session_revocation": true,
    "sidecar_rotation": true,
    "host_env_scrub": true,
    "refresh_proof_logout": true,
    "strict_device_limit": true
  },
  "sha256": "59f30eb653e6f7de7fb64bd8c2217f73a2a9afb49a44a2c246434207f30d91d3"
}
