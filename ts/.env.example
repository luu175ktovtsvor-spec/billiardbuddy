# BilliardBuddy Local Product Server
# Copy this file to .env only for local development. Packaged builds receive
# runtime configuration from the signed product configuration.

# Managed BilliardBuddy Gateway. Use HTTPS and a revocable installation token.
BB_GATEWAY_URL=https://gateway.example.com
BB_GATEWAY_TOKEN=YOUR_GATEWAY_TOKEN
BB_GATEWAY_MODEL=deepseek-v4-flash

# Optional local media toolchain overrides.
# FFMPEG_BIN=/absolute/path/to/ffmpeg
# FFPROBE_BIN=/absolute/path/to/ffprobe

# Optional isolated development data root.
# BILLIARDBUDDY_CONFIG_DIR=/absolute/path/to/billiardbuddy-data

DISABLE_TELEMETRY=1
