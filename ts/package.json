{
  "name": "billiardbuddy-agent-core",
  "version": "999.0.0-local",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck:server": "tsc --project tsconfig.server.json",
    "check:server": "bun run typecheck:server",
    "check:desktop": "cd desktop && bun run lint && bun run build",
    "check:electron": "cd desktop && bun run check:electron",
    "check:native": "cd desktop && bun run build:sidecars && bun run check:electron && CSC_IDENTITY_AUTO_DISCOVERY=false bun run electron:package:dir",
    "audit:source": "bun desktop/scripts/scan-missing-imports.ts",
    "verify:codex-engine-source": "bun desktop/scripts/verify-codex-engine-source.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.44",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.14.0",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.17.23",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "follow-redirects": "^1.16.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  }
}
