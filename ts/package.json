{
  "name": "billiards-ts-harness",
  "version": "0.0.0",
  "module": "index.ts",
  "main": "desktop/electron/main.mjs",
  "author": "球房管家",
  "description": "球房管家 · 桌面 coding agent",
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/bun": "latest",
    "@types/electron": "^1.6.12",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4",
    "vite": "^8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p desktop/renderer-react/tsconfig.json",
    "test": "bun test",
    "ui:dev": "vite desktop/renderer-react",
    "ui:build": "vite build desktop/renderer-react",
    "ui:typecheck": "tsc -p desktop/renderer-react/tsconfig.json",
    "dev:server": "bun run desktop/sidecars/backend-sidecar.ts server --host 127.0.0.1 --port 8850",
    "build:sidecar": "bun run desktop/scripts/build-sidecar.ts",
    "desktop:build": "bun build desktop/electron/main.ts --target=node --format=esm --external=electron --outfile=desktop/electron/main.mjs && bun build desktop/electron/preload.ts --target=node --format=cjs --external=electron --outfile=desktop/electron/preload.cjs",
    "desktop:dev": "bun run desktop:build && electron desktop/electron/main.mjs",
    "desktop:dist": "bun run desktop:build && electron-builder --config electron-builder.yml",
    "smoke:native": "bun run scripts/smoke/native-plugins.smoke.ts",
    "smoke:sandbox": "bun run scripts/smoke/sandbox.smoke.ts",
    "smoke:model": "bun run scripts/smoke/model-live.smoke.ts",
    "smoke:agent-tools": "bun run scripts/smoke/agent-tools-live.smoke.ts"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs",
    "smart-whisper"
  ],
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.63",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "diff": "^9.0.0",
    "dompurify": "^3.3.3",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "marked": "^15.0.7",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  }
}
