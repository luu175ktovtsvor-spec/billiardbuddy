{
  "name": "billiardbuddy-backend",
  "version": "999.0.0-local",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --preload ./test/setup.ts ./test ../gateway ../relay",
    "test:gateway-governance": "bun test --preload ./test/setup.ts ../gateway",
    "test:resource-governance": "bun test --preload ./test/setup.ts ../gateway ../relay ./test/providerAdmission.test.ts",
    "test:images": "bun test --preload ./test/setup.ts ./test/imageWorkbenchBaseline.test.ts ./test/imageWorkbenchCanvasDelivery.test.ts ./test/imageCanvasGolden.test.ts ./test/imageWorkbenchIpcContract.test.ts ./test/imageWorkbenchProviderSmokePolicy.test.ts ./test/imageWorkbenchQwen.test.ts ./test/imageWorkflowC.test.ts ./test/imageWorkflowD.test.ts ./test/imageWorkflowE.test.ts ./test/imageWorkbenchViewState.test.ts",
    "test:images:provider-smoke": "bun test --preload ./test/setup.ts ./test/imageWorkbenchProviderSmoke.ts",
    "typecheck:server": "tsc --project tsconfig.server.json",
    "check:server": "bun run typecheck:server",
    "check:desktop": "cd desktop && bun run lint && bun run build",
    "check:electron": "cd desktop && bun run check:electron",
    "check:native": "cd desktop && bun run build:sidecars && bun run check:electron && CSC_IDENTITY_AUTO_DISCOVERY=false bun run electron:package:dir",
    "audit:source": "bun desktop/scripts/scan-missing-imports.ts",
  "verify:codex-engine-source": "bun desktop/scripts/verify-codex-engine-source.ts && bun desktop/scripts/verify-codex-native-protocol.ts",
  "verify:codex-hook-environment": "bun desktop/scripts/verify-codex-hook-environment.ts",
  "verify:codex-runtime-personal-e2e": "bun desktop/scripts/verify-codex-runtime-personal-e2e.ts",
  "verify:codex-runtime-real-provider": "bun desktop/scripts/verify-codex-runtime-real-provider.ts",
  "verify:codex-runtime-real-agent": "bun desktop/scripts/verify-codex-runtime-real-agent.ts"
  },
  "dependencies": {
    "ali-oss": "6.23.0",
    "@fontsource/noto-sans-sc": "5.2.5",
    "@resvg/resvg-js": "^2.6.2",
    "fontkit": "^2.0.4",
    "jsqr": "^1.4.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "follow-redirects": "^1.16.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  }
}
