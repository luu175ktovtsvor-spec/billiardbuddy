{
  "manifest_version": 3,
  "name": "BilliardBuddy Chrome",
  "version": "0.1.0",
  "description": "Connect a Chrome tab that you choose to BilliardBuddy.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Connect this tab to BilliardBuddy"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging"
  ]
}
