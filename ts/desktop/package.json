{
  "name": "billiardbuddy-desktop",
  "private": true,
  "version": "0.5.0",
  "description": "BilliardBuddy desktop agent for billiards venue operations and content creation.",
  "author": {
    "name": "BilliardBuddy"
  },
  "type": "module",
  "main": "electron-dist/main.cjs",
  "build": {
    "appId": "com.billiardbuddy.desktop",
    "productName": "BilliardBuddy",
    "beforePack": "scripts/electron-before-pack.cjs",
    "afterPack": "scripts/electron-after-pack.cjs",
    "afterSign": "scripts/electron-after-pack.cjs",
    "asar": true,
    "asarUnpack": [
      "runtime-assets/binaries/**"
    ],
    "artifactName": "BilliardBuddy-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://zzyppz.cn/desktop"
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "build-artifacts/electron"
    },
    "files": [
      "dist/**",
      "electron-dist/**",
      "runtime-assets/binaries/**",
      "runtime-assets/icons/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": ".",
        "filter": [
          "product-config.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "runtime-assets/icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "signIgnore": [
        "/Contents/Frameworks/.+\\.(?:pak|bin|dat|nib)$",
        "/Contents/Resources/.+\\.(?:asar|pak|bin|dat|icns|png|jpg|jpeg|gif|svg|ttf|woff|woff2)$"
      ],
      "notarize": true
    },
    "win": {
      "target": "nsis",
      "icon": "runtime-assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "build:electron": "bun run clean:electron-dist && bun build ./electron/main.ts --outfile ./electron-dist/main.cjs --target node --format cjs --external electron && bun build ./electron/preload.ts --outfile ./electron-dist/preload.cjs --target node --format cjs --external electron",
    "build:sidecars": "bun run ./scripts/build-sidecars.ts",
    "stage:media-toolchain": "bun run ./scripts/stage-media-toolchain.ts",
    "verify:media-toolchain": "bun run ./scripts/stage-media-toolchain.ts --verify",
    "stage:codex-engine": "bun run ./scripts/stage-codex-engine.ts",
    "verify:codex-engine": "bun run ./scripts/stage-codex-engine.ts --verify",
    "verify:codex-native-protocol": "bun run ./scripts/verify-codex-native-protocol.ts",
    "verify:codex-managed-live": "bun run ./scripts/verify-codex-managed-live.ts",
    "audit:package": "bun run ./scripts/audit-packaged-resources.ts",
    "clean:electron-dist": "bun run ./scripts/clean-electron-dist.ts",
    "clean:electron-output": "bun run ./scripts/clean-electron-output.ts",
    "build:macos-arm64": "bash ./scripts/build-macos-arm64.sh",
    "build:windows-x64": "powershell -ExecutionPolicy Bypass -File ./scripts/build-windows-x64.ps1",
    "electron:dev": "bun run verify:codex-engine && bun run build:sidecars && bun run build:electron && bun run ./scripts/electron-dev.ts",
    "electron:build": "bun run build:sidecars && bun run build && bun run build:electron",
    "electron:package": "bun run stage:media-toolchain && bun run stage:codex-engine && bun run clean:electron-output && bun run electron:build && node ./node_modules/electron-builder/out/cli/cli.js --publish never",
    "electron:package:dir": "bun run stage:media-toolchain && bun run stage:codex-engine && bun run clean:electron-output && bun run electron:build && node ./node_modules/electron-builder/out/cli/cli.js --dir --publish never",
    "check:electron": "node ./node_modules/typescript/bin/tsc -p electron/tsconfig.json && bun run build:electron",
    "preview": "vite preview",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^25.9.1",
    "electron": "^42.3.0",
    "electron-builder": "26.15.7",
    "electron-builder-squirrel-windows": "26.15.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  }
}
