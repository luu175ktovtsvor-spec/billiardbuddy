{
  "name": "billiardbuddy-desktop",
  "private": true,
  "version": "0.5.0",
  "description": "BilliardBuddy desktop agent for billiards venue operations and content creation.",
  "author": {
    "name": "BilliardBuddy"
  },
  "type": "module",
  "main": "electron-dist/main.cjs",
  "build": {
    "appId": "com.billiardbuddy.desktop",
    "productName": "BilliardBuddy",
    "beforePack": "scripts/electron-before-pack.cjs",
    "afterPack": "scripts/electron-after-pack.cjs",
    "afterSign": "scripts/electron-after-pack.cjs",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "runtime-assets/binaries/**"
    ],
    "artifactName": "BilliardBuddy-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://zzyppz.cn/desktop"
      }
    ],
    "protocols": [
      {
        "name": "BilliardBuddy 任务链接",
        "schemes": [
          "billiardbuddy"
        ]
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "build-artifacts/electron"
    },
    "files": [
      "dist/**",
      "electron-dist/**",
      "node_modules/node-pty/**",
      "runtime-assets/binaries/**",
      "runtime-assets/icons/**",
      "runtime-assets/resources/preview-agent.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension",
        "filter": [
          "manifest.json",
          "service-worker.js",
          "content-script.js"
        ]
      },
      {
        "from": "build",
        "to": ".",
        "filter": [
          "product-config.json",
          "product-secrets.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "runtime-assets/icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "signIgnore": [
        "/Contents/Frameworks/.+\\.(?:pak|bin|dat|nib)$",
        "/Contents/Resources/.+\\.(?:asar|pak|bin|dat|icns|png|jpg|jpeg|gif|svg|ttf|woff|woff2)$"
      ],
      "notarize": true
    },
    "win": {
      "target": "nsis",
      "icon": "runtime-assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run build:preview-agent && node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "prepare:node-pty": "bun run ./scripts/prepare-node-pty.ts",
    "build:electron": "bun run prepare:node-pty && bun build ./electron/main.ts --outfile ./electron-dist/main.cjs --target node --format cjs --external electron --external node-pty && bun build ./electron/preload.ts --outfile ./electron-dist/preload.cjs --target node --format cjs --external electron && bun build ./electron/preview-preload.ts --outfile ./electron-dist/preview-preload.cjs --target node --format cjs --external electron",
    "build:preview-agent": "bun run ./scripts/build-preview-agent.ts",
    "build:sidecars": "bun run ./scripts/build-sidecars.ts",
    "stage:media-toolchain": "bun run ./scripts/stage-media-toolchain.ts",
    "verify:media-toolchain": "bun run ./scripts/stage-media-toolchain.ts --verify",
    "audit:package": "bun run ./scripts/audit-packaged-resources.ts",
    "accept:package:mac": "bun run ./scripts/accept-macos-package.ts",
    "accept:upgrade:mac": "bun run ./scripts/accept-macos-upgrade.ts",
    "accept:upgrade:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/accept-windows-upgrade.ps1",
    "accept:update-recovery:mac": "bun run ./scripts/accept-macos-update-recovery.ts",
    "accept:update-recovery:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/accept-windows-update-recovery.ps1",
    "accept:package:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/accept-windows-package.ps1",
    "clean:electron-output": "bun run ./scripts/clean-electron-output.ts",
    "build:macos-arm64": "bash ./scripts/build-macos-arm64.sh",
    "build:windows-x64": "powershell -ExecutionPolicy Bypass -File ./scripts/build-windows-x64.ps1",
    "electron:dev": "bun run build:electron && bun run ./scripts/electron-dev.ts",
    "electron:build": "bun run build:sidecars && bun run build && bun run build:electron",
    "electron:package": "bun run stage:media-toolchain && bun run clean:electron-output && bun run electron:build && node ./node_modules/electron-builder/out/cli/cli.js --publish never",
    "electron:package:dir": "bun run stage:media-toolchain && bun run clean:electron-output && bun run electron:build && node ./node_modules/electron-builder/out/cli/cli.js --dir --publish never",
    "check:electron": "node ./node_modules/typescript/bin/tsc -p electron/tsconfig.json && bun test electron && bun run build:electron",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.3.3",
    "electron-updater": "^6.8.3",
    "katex": "^0.16.45",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.7",
    "mermaid": "^11.14.0",
    "node-pty": "^1.1.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^3.0.4"
  }
}
