{
  "manifest_version": 3,
  "name": "BilliardBuddy 招聘助手",
  "version": "1.0.0",
  "description": "在用户确认下，把 BOSS 直聘页面中的岗位相关信息连接到 BilliardBuddy。",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "storage"],
  "host_permissions": ["https://zhipin.com/*", "https://*.zhipin.com/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "连接当前招聘页面到 BilliardBuddy" },
  "content_scripts": [{
    "matches": ["https://zhipin.com/*", "https://*.zhipin.com/*"],
    "js": ["content-script.js"],
    "run_at": "document_idle"
  }]
}
