# 真机/手测产物 + 真实门店数据(隐私敏感、绝不入库)
# 注意：live eval 脚本(server/evals/*_live_test.py)写死了"测试项目的AI Agent功能"目录名当落点，
# 故只忽略、别删该目录；老板导出的 POS 报表(经营数据总表.xlsx 等)落在根目录，含真实数据不入库。
测试项目的AI Agent功能/
/经营数据总表.xlsx
/*.xlsx

# Playwright 本地截图/快照产物(验证用,不入库)
.playwright-mcp/
.playwright-cli/
output/
desktop-*.png

# 根目录参考截图杂物
codex-*.png

# 仅用于本地前端调研的只读参考，不进入 Git、构建或安装包
codex-frontend-reference/
# 生图工作台的 InvokeAI 只读参考，不进入 Git、构建或安装包
invokeai-reference/
# 视频工作台的 OpenShot Qt 只读参考，不进入 Git、构建或安装包
openshot-reference/

# 网关配置(含 MiMo/中转 key)——只在服务器,绝不进 git
gateway/*.env
gateway/gw.env

# 装机版可撤销 app token(打包时由构建密钥写入 extraResources,绝不进 git);product-config.json 是公开配置,可入库
ts/desktop/build/product-secrets.json

# 桌面打包生成物：平台图标入库，sidecar/媒体工具链和生成的 preview bundle 不入库
ts/desktop/runtime-assets/binaries/
ts/desktop/runtime-assets/resources/preview-agent.js
ts/desktop/runtime-assets/.DS_Store

# Bun/MCP 单测在包目录旁创建的临时 fixture(中断时可能来不及清理)
**/.agent-plugin-wired-*/
**/.agent-tool-mcp-*/
**/.mcp-client-*/
**/.server-mcp-*/
**/.task-tools-agent-mcp-*/

# 真机验收与 Computer Use 证据保留在仓库内，但不进入 Git
.artifacts/
